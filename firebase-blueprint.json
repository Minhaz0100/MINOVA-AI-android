{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile for MINOVA AI cloud synchronization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique Firebase Auth user ID." },
        "email": { "type": "string", "description": "User email address." },
        "displayName": { "type": "string", "description": "Display name of the user." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp." },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last sign-in timestamp." }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat conversation containing messages and generation settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique conversation ID matching local Room UUID." },
        "userId": { "type": "string", "description": "Owner user ID." },
        "title": { "type": "string", "description": "Conversation title." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp." },
        "isPinned": { "type": "boolean", "description": "Whether the conversation is pinned." },
        "isArchived": { "type": "boolean", "description": "Whether the conversation is archived." },
        "lastMessage": { "type": "string", "description": "Preview snippet of the last message." },
        "responseStyle": { "type": "string", "description": "Preferred response style." },
        "responseLanguage": { "type": "string", "description": "Preferred response language." },
        "responseFormat": { "type": "string", "description": "Preferred response format." }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual chat message within a conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID matching local Room UUID." },
        "conversationId": { "type": "string", "description": "Parent conversation ID." },
        "sender": { "type": "string", "enum": ["USER", "ASSISTANT"], "description": "Message sender role." },
        "content": { "type": "string", "description": "Message text content." },
        "timestamp": { "type": "string", "format": "date-time", "description": "Creation or receipt timestamp." },
        "status": { "type": "string", "enum": ["SENT", "STREAMING", "ERROR"], "description": "Delivery or streaming status." },
        "errorMessage": { "type": "string", "description": "Error details if status is ERROR." },
        "attachmentType": { "type": "string", "description": "Attachment MIME or category type if any." },
        "attachmentName": { "type": "string", "description": "Original file name of attachment." },
        "codeSnippet": { "type": "string", "description": "Associated code snippet." },
        "codeLanguage": { "type": "string", "description": "Language of associated code snippet." },
        "isPinned": { "type": "boolean", "description": "Whether this message is pinned in conversation." }
      },
      "required": ["id", "conversationId", "sender", "content", "timestamp", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile document."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "User-scoped conversation collection for cloud sync."
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "User-scoped messages within a conversation."
    }
  }
}
